QTabBar {
    qproperty-drawBase: 0;
    background: transparent;
    border: none;
    margin: 6px 12px;
}
QTabBar::tab {
    background: rgba(128, 128, 128, 0.12);
    color: palette(text);
    border-radius: 16px;
    padding: 7px 20px;
    margin: 4px 6px;
    font-weight: 600;
    font-size: 13px;
    border: 1px solid rgba(128, 128, 128, 0.15);
}
QTabBar::tab:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
    border: 1px solid palette(highlight);
}
QTabBar::tab:hover:!selected {
    background: rgba(128, 128, 128, 0.22);
    color: palette(text);
}
QTabWidget::pane {
    border: none;
    background: transparent;
    margin: 8px 24px 16px 24px;
}

/* Modern Card Layout for QGroupBox in QWidget KCMs */
QGroupBox {
    background: palette(base);
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 12px;
    margin-top: 16px;
    margin-bottom: 12px;
    padding: 16px 18px;
    font-weight: 600;
    color: palette(text);
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 4px;
    padding: 0 6px;
    background: transparent;
    color: palette(text);
    font-size: 13px;
    font-weight: 700;
}

/* Modern Card Layout for single-form tab pages */
QWidget[singleCard="true"] {
    background: palette(base);
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 12px;
}

/* Modern Oval / Pill Buttons for QWidgets and Footer Bar */
QPushButton {
    background-color: palette(button);
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 16px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 500;
    color: palette(button-text);
    min-height: 20px;
    outline: none;
}

QPushButton:hover {
    background-color: palette(midlight);
    border-color: rgba(128, 128, 128, 0.4);
    color: palette(button-text);
}

QPushButton:pressed {
    background-color: palette(mid);
    border-color: rgba(128, 128, 128, 0.5);
}

QPushButton:disabled {
    background-color: rgba(128, 128, 128, 0.08);
    border-color: rgba(128, 128, 128, 0.15);
    color: rgba(128, 128, 128, 0.6);
}

/* Primary / Highlight button (e.g. Uygula / default) */
QPushButton:default, QPushButton[default="true"] {
    background-color: palette(highlight);
    border: 1px solid palette(highlight);
    color: palette(highlighted-text);
    font-weight: 600;
}

QPushButton:default:hover, QPushButton[default="true"]:hover {
    background-color: palette(highlight);
    border-color: palette(highlight);
    color: palette(highlighted-text);
}

QPushButton:default:pressed, QPushButton[default="true"]:pressed {
    background-color: palette(highlight);
}

QPushButton:default:disabled, QPushButton[default="true"]:disabled {
    background-color: rgba(128, 128, 128, 0.3);
    border-color: transparent;
    color: rgba(128, 128, 128, 0.7);
}

/* Footer dialog button box */
QDialogButtonBox {
    background: transparent;
    border: none;
    margin: 8px 16px;
}

QDialogButtonBox QPushButton {
    border-radius: 16px;
    padding: 6px 20px;
    min-height: 22px;
}

/* Modern Pill QToolButton */
QToolButton {
    background-color: palette(button);
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 16px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: palette(button-text);
    outline: none;
}

QToolButton:hover {
    background-color: palette(midlight);
    border-color: rgba(128, 128, 128, 0.4);
    color: palette(button-text);
}

QToolButton:pressed {
    background-color: palette(mid);
}

QToolButton:disabled {
    background-color: rgba(128, 128, 128, 0.08);
    border-color: rgba(128, 128, 128, 0.15);
    color: rgba(128, 128, 128, 0.6);
}

/* Modern Pill QComboBox */
QComboBox {
    background-color: palette(base);
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 16px;
    padding: 5px 28px 5px 14px;
    min-height: 22px;
    font-size: 13px;
    color: palette(text);
}

QComboBox:hover {
    background-color: palette(midlight);
    border-color: rgba(128, 128, 128, 0.4);
}

QComboBox:on {
    border-color: palette(highlight);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}
